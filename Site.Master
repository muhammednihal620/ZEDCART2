
<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs" Inherits="Site" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"
    "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0" />

    <title>ZED CART</title>

    <asp:ContentPlaceHolder
        ID="head"
        runat="server">
    </asp:ContentPlaceHolder>

    <style type="text/css">
        * {
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f5f7fa;
        }

        .header {
            min-height: 75px;
            background-color: #0b3d91;
            display: flex;
            align-items: center;
            padding: 15px 30px;
            color: white;
            gap: 20px;
            flex-wrap: wrap;
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
            white-space: nowrap;
        }

        .logo span {
            color: #ffd700;
        }

        .menu {
            display: flex;
            gap: 18px;
            align-items: center;
            flex-wrap: wrap;
        }

        .menu a,
        .menu input[type="submit"] {
            color: white;
            text-decoration: none;
            font-size: 15px;
            cursor: pointer;
        }

        .menu a:hover {
            color: #ffd700;
        }

        .search-box {
            margin-left: auto;
            display: flex;
            min-width: 0;
        }

        .search-input {
            width: 180px;
            max-width: 100%;
            height: 38px;
            border: none;
            padding: 10px;
            border-radius: 5px 0 0 5px;
        }

        .search-button {
            height: 38px;
            border: none;
            padding: 0 12px;
            background-color: #ffcc00;
            color: #222;
            cursor: pointer;
            border-radius: 0 5px 5px 0;
        }

        .cart {
            color: white;
            text-decoration: none;
            white-space: nowrap;
        }

        .content {
            width: 100%;
            min-height: 500px;
            padding: 30px 25px;
        }

        img {
            max-width: 100%;
            height: auto;
        }

        input, select, textarea, button {
            max-width: 100%;
        }

        /* Tablet */
        @media screen and (max-width: 992px) {
            .header {
                justify-content: center;
                padding: 15px;
                gap: 15px;
            }

            .menu {
                justify-content: center;
                gap: 14px;
            }

            .search-box {
                margin-left: 0;
            }

            .content {
                padding: 20px 12px;
            }
        }

        /* Mobile */
        @media screen and (max-width: 600px) {
            .header {
                flex-direction: column;
                align-items: stretch;
                padding: 12px 8px;
                gap: 12px;
            }

            .logo {
                text-align: center;
                font-size: 23px;
            }

            .menu {
                justify-content: center;
                gap: 12px;
                width: 100%;
            }

            .menu a,
            .menu input[type="submit"] {
                font-size: 12px;
            }

            .search-box {
                display: flex;
                width: 100%;
                margin: 0;
            }

            .search-input {
                width: 100%;
                min-width: 0;
                flex: 1;
            }

            .search-button {
                padding: 0 10px;
            }

            .cart {
                display: block;
                text-align: center;
            }

            .content {
                padding: 15px 5px;
                min-height: 400px;
            }

            h1 {
                font-size: 25px;
            }

            h2 {
                font-size: 21px;
            }

            h3 {
                font-size: 17px;
            }
        }
    </style>

</head>

<body>
    <form id="form1" runat="server">

        <div class="header">

            <!-- Website Logo -->
            <div class="logo">
                🛍 ZED<span>CART</span>
            </div>

            <!-- Navigation Menu -->
            <div class="menu">

                <asp:HyperLink
                    ID="lnkHome"
                    runat="server"
                    NavigateUrl="~/Default.aspx"
                    Text="Home" />

                <asp:HyperLink
                    ID="lnkProducts"
                    runat="server"
                    NavigateUrl="~/Products.aspx"
                    Text="Products" />

                <!-- Categories Page -->
                <asp:HyperLink
                    ID="lnkCategories"
                    runat="server"
                    NavigateUrl="~/Categories.aspx"
                    Text="Categories" />

                <asp:HyperLink
                    ID="lnkAbout"
                    runat="server"
                    NavigateUrl="~/About.aspx"
                    Text="About" />

                <asp:HyperLink
                    ID="lnkLogin"
                    runat="server"
                    NavigateUrl="~/Login.aspx"
                    Text="Login" />

                <asp:HyperLink
                    ID="lnkRegister"
                    runat="server"
                    NavigateUrl="~/Register.aspx"
                    Text="Register" />

                <asp:HyperLink
                    ID="lnkMyOrders"
                    runat="server"
                    NavigateUrl="~/MyOrders.aspx"
                    Text="My Orders" />

                <asp:LinkButton
                    ID="btnLogout"
                    runat="server"
                    OnClick="btnLogout_Click"
                    CausesValidation="false">
                    Logout
                </asp:LinkButton>

            </div>

            <!-- Product Search -->
            <div class="search-box">

                <asp:TextBox
                    ID="txtSearch"
                    runat="server"
                    CssClass="search-input"
                    placeholder="Search products...">
                </asp:TextBox>

                <asp:Button
                    ID="btnSearch"
                    runat="server"
                    Text="Search"
                    CssClass="search-button"
                    OnClick="btnSearch_Click"
                    CausesValidation="false" />

            </div>

            <!-- Shopping Cart -->
            <asp:HyperLink
                ID="lnkCart"
                runat="server"
                NavigateUrl="~/Cart.aspx"
                CssClass="cart">

                🛒 Cart

                <asp:Label
                    ID="lblCartCount"
                    runat="server"
                    Text="(0)">
                </asp:Label>

            </asp:HyperLink>

        </div>

        <!-- Page Content -->
        <div class="content">

            <asp:ContentPlaceHolder
                ID="ContentPlaceHolder1"
                runat="server">
            </asp:ContentPlaceHolder>

        </div>

    </form>
</body>
</html>
